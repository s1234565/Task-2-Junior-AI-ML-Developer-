# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=health_prediction_db

# Set to true to use SQLite instead of MySQL (for unit tests only)
USE_SQLITE_FALLBACK=false
